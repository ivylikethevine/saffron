#!/bin/sh
# Converts staged jpg/png images to webp and stages the webp in their place.
# install-saffron.sh links this as .git/hooks/pre-commit; needs cwebp.
git diff --cached --name-only --diff-filter=ACMR -z \
  | tr '\0' '\n' \
  | grep -iE '\.(jpe?g|png)$' \
  | while IFS= read -r file; do
    webp="${file%.*}.webp"
    echo "$file --> $webp"
    cwebp -q 50 -mt -quiet "$file" -o "$webp"
    git rm -q --cached "$file" && rm -f "$file"
    git add "$webp"
  done
