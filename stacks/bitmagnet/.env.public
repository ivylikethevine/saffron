# Bitmagnet DHT Crawler & Database Configuration

# VPN Provider (wireguard-based)
# Supported: nordvpn, expressvpn, protonvpn, surfshark, windscribe, etc.
# See: https://github.com/qdm12/gluetun/wiki
PROVIDER=

# Wireguard VPN credentials (obtain from your VPN provider)
PRIVATE_KEY=
PRESHARED_KEY=
ADDRESSES=

# VPN server region(s) - comma-separated for fallback options
# Example: us-east,us-west or ca,ca
REGIONS=

# Database password for PostgreSQL (bitmagnet-postgres)
# Change this to a strong password
POSTGRES_PW=changeme
