services:
  redroid:
    image: erstt/redroid:13.0.0_ndk_ChromeOS
    container_name: redroid
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    privileged: true
    restart: no
    mem_limit: ${REDROID_MEM_LIMIT:-3g}
    memswap_limit: ${REDROID_MEM_LIMIT:-3g}
    shm_size: 1g
    volumes:
      - ./android:/data
    ports:
      - 127.0.0.1:5555:5555
    command:
      - androidboot.redroid_gpu_mode=guest
      - androidboot.redroid_width=${REDROID_WIDTH:-1080}
      - androidboot.redroid_height=${REDROID_HEIGHT:-2340}
      - androidboot.redroid_dpi=${REDROID_DPI:-420}
      - androidboot.redroid_fps=30
      - androidboot.use_memfd=true
    healthcheck:
      test:
        - CMD
        - /system/bin/sh
        - -c
        - '[ "$(/system/bin/getprop sys.boot_completed)" = 1 ]'
      interval: 60s
      timeout: 10s
      start_period: 10m
      retries: 3
  instadroid:
    image: ghcr.io/ivylikethevine/instadroid:v0.1.3
    restart: no
    container_name: instadroid
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    privileged: true
    depends_on:
      redroid:
        condition: service_started
    network_mode: host
    env_file: .env
    environment:
      REDROID_IMAGE: erstt/redroid:13.0.0_ndk_ChromeOS
      IG_AUTO_INSTALL: 1
    ports:
      - 8000:8000
    volumes:
      - /etc/timezone:/etc/timezone
      - ./db:/db
      - ./media:/media
      - ./debug:/debug
    mem_limit: 256m
    memswap_limit: 256m
networks: {}
