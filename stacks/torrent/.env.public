## Defaults
# Port gluetun forwards to qbittorrent and portcheck verifies
VPN_INPUT_PORT=8999
# Inbound ports gluetun's firewall allows (comma-separated)
PORTS=8999
# Port-forwarding listener for providers that support it
TRACKER_PORT=8999

## VPN credentials (wireguard), define in .env
## Provider names and keys: https://github.com/qdm12/gluetun-wiki
# PROVIDER=
# PRIVATE_KEY=
# PRESHARED_KEY=
# ADDRESSES=
# REGIONS=

## qBittorrent WebUI login used by portcheck, define in .env
## USER is inherited from dockge's environment
# PASSWORD=
