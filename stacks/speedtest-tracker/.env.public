# Speedtest Tracker Configuration

# Laravel application encryption key (required)
# Generate with: docker run linuxserver/speedtest-tracker:latest php artisan key:generate --show
# Must start with 'base64:' prefix
APP_KEY=base64:changeme

# Public URL for the application
# Used for generating links and webhooks
# Example: http://speedtest.hostname.local:8011 or https://speedtest.example.com
APP_URL=http://localhost:8011

# Speedtest schedule (cron format)
# Default: every 6 hours
# Examples:
#   0 */6 * * * = every 6 hours
#   0 * * * * = hourly
#   0 0 * * * = daily at midnight
SPEEDTEST_SCHEDULE=0 */6 * * *

# Optional: Restrict tests to specific Speedtest server IDs
# Comma-separated list of server IDs
# Leave commented to use any available server
#SPEEDTEST_SERVERS=52365,36998
