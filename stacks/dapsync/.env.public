# Navidrome server tracks are downloaded from
# Default reaches the navidrome stack's published port on this host
# NAVIDROME_URL=http://host.docker.internal:4533

# Navidrome account dapsync signs in as (required)
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Host path where the DAP's SD card is mounted
# DAP_MOUNT=/mnt/dap
