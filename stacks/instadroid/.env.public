# Instagram account the scraper logs in as (required)
IG_USERNAME=username
IG_PASSWORD=password

# IANA timezone for the Android device and the feeds (empty = UTC)
#TZ=America/Los_Angeles

# Feed server; the default binds loopback only
# Set FEED_HOST=0.0.0.0 (and FEED_TOKEN) for LAN access
#FEED_HOST=127.0.0.1
#FEED_PORT=8000
#PUBLIC_URL=http://localhost:8000
#FEED_TOKEN=

# Android device sizing, read by compose
#REDROID_MEM_LIMIT=3g
#REDROID_WIDTH=1080
#REDROID_HEIGHT=2340
#REDROID_DPI=420

# Every other setting: https://github.com/ivylikethevine/instadroid/blob/v0.1.3/.env.example
