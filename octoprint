version: "3.9"
services:
  octoprint:
    image: octoprint/octoprint
    container_name: octoprint
    restart: always
    ports:
      - 85:80
    volumes:
      - /containers/octoprint:/octoprint
      - /run/udev:/run/udev
      - /dev:/dev
    extends:
      file: ../common.yaml
      service: base-settings
    networks:
      - ustreamer_default
    device_cgroup_rules:
      - c 188:* rwm
      - c 189:* rwm
    privileged: true
#   devices:
#     - /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0:/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
networks:
  ustreamer_default:
    external: true
